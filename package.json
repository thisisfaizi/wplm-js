{
  "name": "@wplm/sdk",
  "version": "0.2.0",
  "description": "Official JavaScript/TypeScript SDK for WP License Manager (WPLM) — online + offline license validation.",
  "type": "module",
  "license": "MIT",
  "keywords": ["licensing", "drm", "wordpress", "ed25519", "electron", "license"],
  "homepage": "https://github.com/wplm/wplm-js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.8.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.12.0",
    "vitest": "^4.0.0"
  }
}
